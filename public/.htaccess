# 本番公開前の最終確認で追加した基本的なセキュリティヘッダー（NFR-02関連）。
# mod_headersが無効な環境でもエラーにならないよう<IfModule>で保護する。
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ドットファイル（.env・.git配下・.htaccess自体等）への直接アクセスを拒否する多層防御。
# .envや.gitはpublic/の外（リポジトリルート）に置いており、DocumentRootがpublic/である限り
# 本来アクセス不可能だが、設定誤り等への保険として明示的に拒否する。
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
